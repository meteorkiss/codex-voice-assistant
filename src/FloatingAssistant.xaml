<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="MainWindow" Title="声伴 · Codex" Width="430" Height="710"
        MinWidth="390" MinHeight="280" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#EAF0FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="QuietText" Color="#93A0BD" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DFE8FA" />
      <Setter Property="Background" Value="#1D283D" />
      <Setter Property="BorderBrush" Value="#35415A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#95A3BE" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#DFE8FA" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="#80E5EF" />
      <Setter Property="SelectionBrush" Value="#526B97" />
      <Setter Property="SelectionOpacity" Value="0.7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Border Margin="8" CornerRadius="24" BorderBrush="#3C4A68" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#030815" BlurRadius="15" ShadowDepth="2" Opacity="0.45" />
    </Border.Effect>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#182137" Offset="0" />
        <GradientStop Color="#111827" Offset="0.6" />
        <GradientStop Color="#161A2E" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="20,15,20,17">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Name="DragHandle" Background="Transparent" Height="29" Margin="0,0,0,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="7" Height="7" Background="#6ADDE4" CornerRadius="4" Margin="0,0,9,0" />
          <TextBlock Text="声伴" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text=" / CODEX" FontFamily="Segoe UI" FontSize="11" Foreground="#8393B5" Margin="7,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Name="CompactButton" Content="收起" ToolTip="收起文字区域"
                Padding="7,4" FontSize="11" Foreground="#95A3BE" Background="Transparent" BorderThickness="0" />
        <Button Grid.Column="2" Name="MinimizeButton" Content="−" Style="{StaticResource ChromeButton}" ToolTip="最小化到托盘" />
        <Button Grid.Column="3" Name="CloseButton" Content="×" Style="{StaticResource ChromeButton}" ToolTip="关闭悬浮窗" />
      </Grid>

      <Button Grid.Row="1" Name="TaskButton" Padding="11,9" Background="#131D30" BorderBrush="#2B3853"
              HorizontalContentAlignment="Stretch" ToolTip="选择要对话的 Codex 任务">
        <Grid Width="342">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="任务" Foreground="#8796B3" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Name="TaskLabel" Text="等待连接 Codex" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="⌄" Foreground="#8393B5" FontFamily="Segoe UI" FontSize="15" Margin="6,-3,0,0" />
        </Grid>
      </Button>

      <Grid Grid.Row="2" Name="VoiceSection" Height="160">
        <Grid.RowDefinitions>
          <RowDefinition Height="129" />
          <RowDefinition Height="31" />
        </Grid.RowDefinitions>
        <Grid Width="118" Height="118" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="113" Height="113" Opacity="0.48">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#555892CF" Offset="0" />
                <GradientStop Color="#445D6DB9" Offset="0.55" />
                <GradientStop Color="#005D6DB9" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Grid Width="83" Height="83" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
            <Ellipse Stroke="#406EA4D2" StrokeThickness="1">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#4968B8E0" Offset="0" />
                  <GradientStop Color="#2A5664B6" Offset="0.55" />
                  <GradientStop Color="#55786AC1" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Margin="8" Stroke="#506F93C7" StrokeThickness="1" />
          </Grid>
        </Grid>
        <Canvas Name="WaveCanvas" Width="260" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="8" Canvas.Top="26.5" Fill="#6878C2" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="20" Canvas.Top="26.5" Fill="#7083CD" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="32" Canvas.Top="26.5" Fill="#7B94D8" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="44" Canvas.Top="26.5" Fill="#81A9E0" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="56" Canvas.Top="26.5" Fill="#80BFE9" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="68" Canvas.Top="26.5" Fill="#81D2EC" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="80" Canvas.Top="26.5" Fill="#8ADFEF" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="92" Canvas.Top="26.5" Fill="#94E6F1" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="104" Canvas.Top="26.5" Fill="#A7EEF5" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="116" Canvas.Top="26.5" Fill="#B9F5F8" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="128" Canvas.Top="26.5" Fill="#C9FCFD" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="140" Canvas.Top="26.5" Fill="#B9F5F8" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="152" Canvas.Top="26.5" Fill="#A7EEF5" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="164" Canvas.Top="26.5" Fill="#94E6F1" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="176" Canvas.Top="26.5" Fill="#8ADFEF" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="188" Canvas.Top="26.5" Fill="#81D2EC" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="200" Canvas.Top="26.5" Fill="#80BFE9" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="212" Canvas.Top="26.5" Fill="#81A9E0" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="224" Canvas.Top="26.5" Fill="#7B94D8" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="236" Canvas.Top="26.5" Fill="#7083CD" />
          <Rectangle Width="4" Height="3" RadiusX="2" RadiusY="2" Canvas.Left="248" Canvas.Top="26.5" Fill="#6878C2" />
        </Canvas>
        <TextBlock Grid.Row="1" Name="StatusLabel" Text="正在连接…" FontSize="12"
                   HorizontalAlignment="Center" Foreground="#A8B8D3" VerticalAlignment="Top" />
      </Grid>

      <Grid Grid.Row="3" Name="ExpandedPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="95" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#0E1626" BorderBrush="#26334C" BorderThickness="1" CornerRadius="13" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <TextBlock Text="CODEX 的回答" Foreground="#8293B4" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Name="AnswerStateLabel" Text="文字 · 语音" Foreground="#5F718F" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
            <TextBox Grid.Row="1" Name="AnswerBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontSize="14" Text="Codex 的回答会显示在这里，并自动朗读。"
                     AcceptsReturn="True" AutomationProperties.Name="Codex 的回答" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Name="InputSection" Margin="0,12,0,0" Background="#172135"
                BorderBrush="#2F3D57" BorderThickness="1" CornerRadius="13" Padding="14,11">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="76" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="你说的话" Foreground="#9AAAC5" FontSize="11" />
              <TextBlock Text="发送前可以修改" Foreground="#6D7F9E" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
            <TextBox Grid.Row="1" Name="InputBox" AcceptsReturn="True" Text=""
                     AutomationProperties.Name="要发送给 Codex 的内容" />
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <Grid Height="43">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="91" />
          </Grid.ColumnDefinitions>
          <Button Name="SpeakButton" Content="开始说话" Background="#8CE4E6" Foreground="#0B2633"
                  BorderThickness="0" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                  ToolTip="开始录音；正在朗读的声音会先停止" />
          <Button Grid.Column="1" Name="SendButton" Content="发送" Margin="0,0,8,0" ToolTip="把上面的文字发送到当前 Codex 任务" />
          <Button Grid.Column="2" Name="StopButton" Content="停止朗读" Padding="8,8" ToolTip="立即停止当前朗读" />
        </Grid>
        <Grid Margin="1,12,1,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="FooterHint" Text="开始说话时，会先停止朗读" Foreground="#7789A8" FontSize="10" VerticalAlignment="Center" />
          <CheckBox Grid.Column="1" Name="HandsFreeToggle" Content="语音唤醒" FontSize="11" Margin="0,0,10,0"
                    Foreground="#8CE4E6" VerticalAlignment="Center" Cursor="Hand" ToolTip="待机时在本机监听唤醒词；朗读期间暂停监听" />
          <CheckBox Grid.Column="2" Name="PinToggle" IsChecked="True" Content="置顶" FontSize="11"
                    Foreground="#A5B4CD" VerticalAlignment="Center" Cursor="Hand" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
