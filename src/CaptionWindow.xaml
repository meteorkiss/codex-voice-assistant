<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="CaptionWindow" Title="声伴字幕" Width="500" Height="280" MinWidth="380" MinHeight="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        ShowActivated="False" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#27272A" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#343439"/><Setter Property="BorderBrush" Value="#CECED4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#007AFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#27272A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="CaretBrush" Value="#007AFF"/><Setter Property="SelectionBrush" Value="#B9D9FF"/><Setter Property="Padding" Value="0"/></Style>
  </Window.Resources>
  <Border Background="#FAFAFC" BorderBrush="#CFCFD5" BorderThickness="1" CornerRadius="10" Padding="16,12,16,12" Margin="3">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Name="CaptionDragHandle" Background="Transparent" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Name="CaptionTaskLabel" Text="声伴" FontSize="12" Foreground="#77777D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Name="ConversationToggleButton" Grid.Column="1" Content="连续对话" FontSize="11" Foreground="#0067D8" Padding="7,3" Background="#EAF3FF" BorderBrush="#B9D8FF" AutomationProperties.Name="开启或暂停连续对话"/><Button Name="ReplayButton" Grid.Column="2" Content="重读" FontSize="11" Foreground="#62626A" Padding="6,3" Background="Transparent" BorderThickness="0"/><Button Name="PauseResumeButton" Grid.Column="3" Content="暂停朗读" FontSize="11" Foreground="#62626A" Padding="6,3" Background="Transparent" BorderThickness="0" AutomationProperties.Name="暂停或继续朗读"/><Button Name="CaptionExpandButton" Grid.Column="4" Content="展开" FontSize="11" Foreground="#62626A" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="展开全文与输入"/><Button Name="CaptionCloseButton" Grid.Column="5" Content="×" FontFamily="Segoe UI" FontSize="17" Foreground="#76767C" Background="Transparent" BorderThickness="0" Padding="5,0" ToolTip="隐藏字幕" AutomationProperties.Name="隐藏字幕"/></Grid>
      <Border Name="ConversationPanel" Grid.Row="1" Background="#F1F7FF" BorderBrush="#C9DDF7" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="与声伴连续对话 · 分句转写" FontSize="11" FontWeight="SemiBold" Foreground="#41658D"/><TextBlock Name="ConversationStateLabel" Grid.Row="1" Text="连续对话默认关闭。" FontSize="10" Foreground="#66809D" Margin="0,4,0,6" TextWrapping="Wrap"/><TextBox Name="ConversationBox" Grid.Row="2" Text="" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="13" MaxHeight="150" MinHeight="48" AcceptsReturn="True" AutomationProperties.Name="与声伴的连续对话"/></Grid></Border>
      <TextBox Name="AnswerBox" Grid.Row="2" Text="" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="15" AcceptsReturn="True" AutomationProperties.Name="Codex 的完整回答"/>
      <Border Name="CaptionInputPanel" Grid.Row="3" Background="White" BorderBrush="#DCDCE0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,13,0,10" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="65"/></Grid.RowDefinitions><TextBlock Text="消息" FontSize="11" Foreground="#808086" Margin="0,0,0,6"/><TextBox Name="InputBox" Grid.Row="1" Text="" AcceptsReturn="True" AutomationProperties.Name="要发送给 Codex 的内容"/></Grid></Border>
      <Grid Name="CaptionActions" Grid.Row="4" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Button Name="SpeakButton" Content="开始说话" Background="#007AFF" Foreground="White" BorderBrush="#0071EA" Margin="0,0,8,0"/><Button Name="SendButton" Grid.Column="1" Content="发送" Margin="0,0,8,0"/><Button Name="StopButton" Grid.Column="2" Content="停止朗读" Padding="5,6"/></Grid>
      <TextBlock Name="CaptionStatus" Grid.Row="5" Text="" FontSize="11" Foreground="#85858B" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
      <TextBlock Name="AnswerStateLabel" Visibility="Collapsed"/>
    </Grid>
  </Border>
</Window>
